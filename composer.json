{
    "name": "taketool/sitepackage",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "description": "Sitepackage for t3v13+14 on Bootstrap-Package by Benjamin Kott",
    "authors": [
        {
            "name": "Martin Keller",
            "role": "Developer"
        }
    ],
    "version": "13.0.0",
    "require": {
        "typo3/cms-core": "^13.4 || ^14.3",
        "b13/container": "^4.1.0",
        "bk2k/bootstrap-package": "^16.0"
    },
    "replace": {
        "laxap/bootstrap_grids":"*",
        "typo3-ter/sitepackage": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Taketool\\Sitepackage\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Taketool\\Sitepackage\\Tests\\": "Tests"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "sitepackage"
        }
    }
}
