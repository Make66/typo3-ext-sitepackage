{
    "name": "taketool/sitepackage",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "description": "Container elements and other stuff",
    "authors": [
        {
            "name": "Martin Keller",
            "role": "Developer"
        }
    ],
    "version": "1.0.0",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "typo3/cms-core": "^11.5 || ^12.4 || ^13.4 || ^14.3",
        "typo3/cms-seo": "^11.5 || ^12.4 || ^13.4 || ^14.3"
    },
    "replace": {
        "laxap/bootstrap_grids":"*",
        "typo3-ter/sitepackage": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Taketool\\Sitepackage\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Taketool\\Sitepackage\\Tests\\": "Tests"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "sitepackage"
        }
    }
}

