        <header/>
        <body>
            <trans-unit id="table" xml:space="preserve">
                <source>Website configuration</source>
            </trans-unit>
            <trans-unit id="field.settings" xml:space="preserve">
                <source>Settings</source>
            </trans-unit>
            <trans-unit id="label.prefix" xml:space="preserve">
                <source>Configuration</source>
            </trans-unit>
            <trans-unit id="inherit" xml:space="preserve">
                <source>Inherited: %s</source>
            </trans-unit>
            <trans-unit id="bool.yes" xml:space="preserve">
                <source>Yes</source>
            </trans-unit>
            <trans-unit id="bool.no" xml:space="preserve">
                <source>No</source>
            </trans-unit>
            <trans-unit id="form.intro" xml:space="preserve">
                <source>Filled fields override the settings of website "%s". Empty fields inherit; the grey hint shows the current value.</source>
            </trans-unit>
            <trans-unit id="form.overridden" xml:space="preserve">
                <source>overridden</source>
            </trans-unit>
            <trans-unit id="form.movedToRoot" xml:space="preserve">
                <source>This configuration will be stored on the root page "%s" [%s].</source>
            </trans-unit>
            <trans-unit id="form.noSite.title" xml:space="preserve">
                <source>No website</source>
            </trans-unit>
            <trans-unit id="form.noSite.message" xml:space="preserve">
                <source>This page does not belong to a website configuration, so there are no settings to edit.</source>
            </trans-unit>
            <trans-unit id="form.exists.title" xml:space="preserve">
                <source>Configuration already exists</source>
            </trans-unit>
            <trans-unit id="form.exists.message" xml:space="preserve">
                <source>The website "%s" (%s) already has a configuration on its root page. Each website has exactly one.</source>
            </trans-unit>
            <trans-unit id="form.exists.button" xml:space="preserve">
                <source>Edit existing configuration</source>
            </trans-unit>
            <trans-unit id="form.noSets.title" xml:space="preserve">
                <source>Nothing to configure</source>
            </trans-unit>
            <trans-unit id="form.noSets.message" xml:space="preserve">
                <source>Website "%s" includes no site sets with editable settings.</source>
            </trans-unit>
            <trans-unit id="error.noSite" xml:space="preserve">
                <source>Website configuration not saved: page %s does not belong to a website.</source>
            </trans-unit>
            <trans-unit id="error.duplicate" xml:space="preserve">
                <source>Website configuration not saved: website "%s" already has one (record %s).</source>
            </trans-unit>
            <trans-unit id="error.moveCopy" xml:space="preserve">
                <source>Website configurations cannot be moved or copied; each one belongs to the root page of its website.</source>
            </trans-unit>
            <trans-unit id="error.undeleteDuplicate" xml:space="preserve">
                <source>Not restored: root page %s already has a website configuration.</source>
            </trans-unit>
            <trans-unit id="error.notAllowed" xml:space="preserve">
                <source>Setting "%s" cannot be changed here and was ignored.</source>
            </trans-unit>
            <trans-unit id="error.invalid" xml:space="preserve">
                <source>Invalid value for "%s" (%s); the previous value was kept.</source>
            </trans-unit>
            <trans-unit id="extconf.sets" xml:space="preserve">
                <source>Site sets offered in the website configuration (comma-separated, wildcards allowed)</source>
            </trans-unit>
            <trans-unit id="extconf.excludeSettings" xml:space="preserve">
                <source>Settings never offered in the website configuration, e.g. API keys (comma-separated, wildcards allowed)</source>
            </trans-unit>
            <trans-unit id="extconf.tabOrder" xml:space="preserve">
                <source>Tab order of the site sets (comma-separated, wildcards allowed; unlisted sets follow)</source>
            </trans-unit>
            <trans-unit id="form.sections" xml:space="preserve">
                <source>Sections</source>
            </trans-unit>
