plugin.tx_sitepackage_contact {
    view {
        templateRootPaths {
            0 = EXT:sitepackage/Resources/Private/Templates/
            10 = EXT:sitepackage/Resources/Private/_{$layout}/Templates/
        }
        partialRootPaths {
            0 = EXT:sitepackage/Resources/Private/Partials/
            10 = EXT:sitepackage/Resources/Private/_{$layout}/Partials/
        }
        layoutRootPaths {
            0 = EXT:sitepackage/Resources/Private/Layouts/
            10 = EXT:sitepackage/Resources/Private/_{$layout}/Layouts/
        }
    }
}
