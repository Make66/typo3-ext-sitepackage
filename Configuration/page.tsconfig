## Eigene Rahmen fuer Content Elemente
TCEFORM.tt_content.frame_class {
    addItems {
    sliderstartseite = Slider (Höhe 72%)
    volle_breite = Volle Breite (mit Hintergrund)
    rahmen_ueberlappen = Überlappen
    startpage-quicklinks = Startseiten-Kacheln
    search = Suche
    icon-frame= Icons mit Rahmen
    ohne_abstand = Ohne Abstand oben/unten
    }
}

## Eigene Class fuer Content Elemente
TCEFORM.tt_content.frame_layout {
    addItems {
        galerie = Galerie
        box_image_text = Box: Bild und Text
        overlap = Element überlappen
    }
}


## Eigene Hintergrundfarbe fuer Content Elemente
TCEFORM.tt_content.background_color_class {
    addItems {
        primary-light = Primary Light
        secondary-light = Secondary Light
    }
}

TCEFORM.pages.layout {
    addItems {
    }
}

## Icon Group: zusaetzliche Spaltenanzahl
TCEFORM.tt_content.pi_flexform.icon_group.sDEF.columns.addItems {
    5 = 5
    6 = 6
}

## Vorauswahl Layout bei neuen Carousel-Slides
TCAdefaults.tx_bootstrappackage_carousel_item.layout = primary

## Eigene Zusatzklassen im Carousel-Slider
TCEFORM.tx_bootstrappackage_carousel_item.header_class.addItems{
    fadeIn = Textanimation einblenden
    fadeInDown = Textanimation von oben nach unten
    fadeInLeft = Textanimation von links nach rechts
    fadeInRight = Textanimation von rechts nach links
    fadeInUp =  Textanimation  von unten nach oben
    bounceIn = Textanimation hüpfen
    button = Button
}


TCEFORM.tx_bootstrappackage_carousel_item.subheader_class.addItems {
    fadeIn = Textanimation einblenden
    fadeInDown = Textanimation von oben nach unten
    fadeInLeft = Textanimation von links nach rechts
    fadeInRight = Textanimation von rechts nach links
    fadeInUp =  Textanimation  von unten nach oben
    bounceIn = Textanimation hüpfen
    button = Button
}
